.wrap{max-width:820px;margin:0 auto;padding:0 20px 120px}

/* ── 題名頁 ── */
header.hero{padding:64px 0 40px;border-bottom:1px solid var(--line);margin-bottom:8px}
.eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.28em;color:var(--gold);
