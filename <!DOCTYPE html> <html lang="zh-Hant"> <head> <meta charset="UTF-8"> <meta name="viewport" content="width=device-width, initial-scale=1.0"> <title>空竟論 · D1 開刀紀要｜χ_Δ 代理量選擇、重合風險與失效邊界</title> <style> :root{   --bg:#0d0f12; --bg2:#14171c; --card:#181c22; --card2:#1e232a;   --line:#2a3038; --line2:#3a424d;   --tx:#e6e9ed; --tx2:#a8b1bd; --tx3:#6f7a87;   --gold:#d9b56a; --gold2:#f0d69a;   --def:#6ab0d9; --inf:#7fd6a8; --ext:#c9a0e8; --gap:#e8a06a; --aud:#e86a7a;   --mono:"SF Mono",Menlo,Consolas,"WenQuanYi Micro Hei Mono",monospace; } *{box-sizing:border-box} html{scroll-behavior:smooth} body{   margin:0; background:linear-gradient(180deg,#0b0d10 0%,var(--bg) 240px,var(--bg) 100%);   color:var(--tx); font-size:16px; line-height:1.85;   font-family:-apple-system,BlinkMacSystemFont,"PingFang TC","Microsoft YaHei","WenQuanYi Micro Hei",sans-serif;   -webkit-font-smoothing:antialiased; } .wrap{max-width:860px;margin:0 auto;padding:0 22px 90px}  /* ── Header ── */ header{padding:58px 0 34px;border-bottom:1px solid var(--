.motto{margin:28px 0 0;padding:18px 22px;border-left:2px solid var(--gold);
  background:linear-gradient(90deg,#e3b3410d,transparent);color:var(--fg2);font-size:15px}
.motto b{color:var(--gold);font-weight:600}

/* ── 版本卡 ── */
.meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;
  background:var(--line);border:1px solid var(--line);border-radius:10px;overflow:hidden;margin:28px 0 0}
.meta div{background:var(--bg2);padding:14px 16px}
.meta dt{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;color:var(--fg3);margin:0 0 5px}
.meta dd{margin:0;font-family:var(--mono);font-size:12.5px;color:var(--fg);word-break:break-all}
.meta dd.ok{color:var(--green)}

/* ── 標籤圖例 ── */
.tags{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0 0}
.tg{font-family:var(--mono);font-size:11.5px;padding:4px 11px;border-radius:20px;
  border:1px solid var(--line);background:var(--card);color:var(--fg2);cursor:help;transition:.2s}
.tg:hover{border-color:var(--fg3);color:var(--fg)}
.tg b{font-weight:600}
.tg[data-t="定"] b{color:var(--cyan)} .tg[data-t="推"] b{color:var(--green)}
.tg[data-t="外"] b{color:var(--amber)} .tg[data-t="空"] b{color:var(--violet)}
.tg[data-t="審"] b{color:var(--red)}

/* ── 目錄 ── */
nav.toc{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:22px 24px;margin:36px 0 0}
nav.toc h2{font-size:12px;font-family:var(--mono);letter-spacing:.22em;color:var(--fg3);margin:0 0 16px;font-weight:400}
nav.toc ol{list-style:none;margin:0;padding:0;counter-reset:v}
nav.toc>ol>li{counter-increment:v;margin:0 0 4px}
nav.toc>ol>li>a::before{content:counter(v,decimal-leading-zero)"  ";font-family:var(--mono);
