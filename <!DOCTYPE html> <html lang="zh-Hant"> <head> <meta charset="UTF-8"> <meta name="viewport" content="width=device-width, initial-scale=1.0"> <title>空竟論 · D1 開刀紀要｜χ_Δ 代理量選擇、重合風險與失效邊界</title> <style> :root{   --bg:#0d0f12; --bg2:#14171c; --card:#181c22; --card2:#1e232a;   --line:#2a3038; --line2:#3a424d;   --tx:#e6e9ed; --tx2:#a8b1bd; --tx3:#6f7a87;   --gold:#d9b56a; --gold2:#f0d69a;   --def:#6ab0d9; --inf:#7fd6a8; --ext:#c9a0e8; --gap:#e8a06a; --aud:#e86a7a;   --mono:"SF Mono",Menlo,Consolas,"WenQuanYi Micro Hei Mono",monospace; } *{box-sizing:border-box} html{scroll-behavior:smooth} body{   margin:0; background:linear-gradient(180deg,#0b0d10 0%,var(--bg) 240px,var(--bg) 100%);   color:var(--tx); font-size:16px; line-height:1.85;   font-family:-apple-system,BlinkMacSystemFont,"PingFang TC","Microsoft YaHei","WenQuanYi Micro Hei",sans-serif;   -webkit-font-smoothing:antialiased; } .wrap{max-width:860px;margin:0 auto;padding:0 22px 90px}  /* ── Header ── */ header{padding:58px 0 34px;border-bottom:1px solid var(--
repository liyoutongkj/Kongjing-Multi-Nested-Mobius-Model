<style>
:root{
  --bg:#0d1117; --bg2:#121923; --card:#161d29; --line:#24304250;
  --fg:#e6edf3; --fg2:#9fb0c4; --fg3:#6e7f96;
  --gold:#e3b341; --cyan:#56d4dd; --violet:#a371f7; --amber:#f0a35e;
  --red:#f07178; --green:#7ee787;
  --mono:"SF Mono",Menlo,Consolas,"Noto Sans Mono CJK TC",monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang TC","Noto Sans CJK TC","Microsoft YaHei",sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth; -webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--sans);
