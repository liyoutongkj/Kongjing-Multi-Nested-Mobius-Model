h1.title{font-size:clamp(28px,7vw,46px);line-height:1.2;margin:0 0 6px;font-weight:700;letter-spacing:.02em}
h1.title small{display:block;font-family:var(--mono);font-size:clamp(11px,2.6vw,14px);
